# Copy this file to .env and adjust for your environment.
# All values are optional — sensible defaults are used if unset.

# Path to the processed food dataset CSV
FOOD_DATASET_PATH=datasets/processed/processed_food_dataset.csv

# Directory containing trained .pkl models
TRAINED_MODELS_DIR=trained_models

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" for local development. Set explicitly before deploying publicly.
CORS_ORIGINS=*
